{
  "name": "kananpos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --host",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.scripts.json",
    "preview": "vite preview",
    "catalogo": "node --env-file-if-exists=.env.catalogo scripts/importar-catalogo.mjs",
    "clientes": "node --env-file-if-exists=.env.clientes scripts/clientes.mjs",
    "fotos": "node --env-file-if-exists=.env.catalogo scripts/fotos-productos.mjs",
    "test": "vitest run",
    "singles": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file-if-exists=.env.clientes scripts/singles/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "jsbarcode": "^3.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^3.2.7"
  }
}
